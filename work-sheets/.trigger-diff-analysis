  "_docs": {
    "_purpose": "This section is documentation only. The workflow ignores everything under '_docs'. Edit the fields above to configure the next run.",

    "sheet": {
      "description": "Which Google Sheet to analyze",
      "valid_values": {
        "documents": "UBL 2.5 Documents sheet (102 worksheets, ~910 KB/rev, ~2161 revisions). Each ODS contains one worksheet per UBL document type (Invoice, Order, etc). Uses --all-sheets mode.",
        "library":   "UBL 2.5 Library sheet (single worksheet, ~625 KB/rev, ~2005 revisions). Contains the reusable component library (BBIEs, ABIEs, etc).",
        "all":       "Run BOTH sheets as parallel matrix jobs on the same runner trigger. Each sheet gets its own job, artifact, and summary."
      },
      "default": "documents"
    },

    "range": {
      "description": "Which revisions to include in the diff analysis",
      "valid_values": {
        "all":       "Every revision available in the Google Drive folder (uses --all)",
        "50-100":    "Revision range — downloads and diffs revisions 50 through 100 inclusive",
        "1793,1803,1983": "Comma-separated list — only these specific revision numbers"
      },
      "note": "Revision numbers are Google Drive revision IDs, not sequential. See revision-ods/manifest.json for known revision-to-workflow mappings.",
      "default": "all"
    },

    "text_only": {
      "description": "When true, ignores cell formulas and only compares displayed text values. Strongly recommended — Google Sheets formula references shift when columns are inserted/deleted, creating massive noise that obscures real edits.",
      "valid_values": {
        "true":  "Compare text content only (recommended). Eliminates thousands of false-positive formula-reference changes.",
        "false": "Compare formulas too. Useful if you specifically want to track formula structure changes."
      },
      "default": true
    },

    "how_to_trigger": {
      "option_1": "Edit this file, commit, and push to the claude/analyze-sheet-diff-0EZru branch",
      "option_2": "Use the GitHub Actions UI: Actions > ODS Revision Diff Analysis > Run workflow",
      "note": "The workflow_dispatch UI has the same sheet/range/text_only options as dropdown and text fields"
    },

    "resource_estimates": {
      "documents_all": "~2161 revisions, ~1.9 GB download (~10 min with 10 workers), ~30 min diff, ~131 MB peak RAM",
      "library_all":   "~2005 revisions, ~1.2 GB download (~10 min with 10 workers), ~20 min diff, ~90 MB peak RAM",
      "both_parallel":  "Runs on separate runners, so resources are NOT shared. Total wall time = max(documents, library) ≈ 40 min.",
      "runner_limits":  "GitHub free runner: 2 CPU, 7 GB RAM, ~14 GB disk, 6 hr timeout"
